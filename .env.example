# DevTool Copilot 环境变量模板
# 复制本文件为 .env 并按需填写（.env 已被 gitignore，不会提交）

# DeepSeek API Key（AI 规划/诊断/洞察/根因/节奏解读/代码审查 都依赖它）
# 申请地址：https://platform.deepseek.com  -> API Keys -> 创建
DEEPSEEK_API_KEY=sk-xxxxxx

# 可选：MySQL（默认 localhost:3306/devtool_copilot root/123456）
# DB_URL=jdbc:mysql://localhost:3306/devtool_copilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# DB_USERNAME=root
# DB_PASSWORD=123456

# 可选：SMTP 邮件（邀请/通知用）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=xxxx
# SMTP_AUTH=true
# SMTP_STARTTLS=false
